extends SceneTree
## Reproducible EDITOR-TIME importer. Saves genuine paintable TileMapLayer
## scenes, SpriteFrames resources, prefab NPCs and a native Control HUD.
## No terrain is generated by gameplay scripts during actual play.

const T: int = 32
const MAP_PATH := "res://data/world_layout.json"
const TILESET_PATH := "res://resources/tilesets/village.tres"
const ROOT_SCENE := "res://scenes/main.tscn"
const ANIMATION_DIRECTIONS := ["down", "left", "right", "up"]

func _initialize() -> void:
    call_deferred("_run")

func _run() -> void:
    print("[BUILDER] Creating a native Godot editor project...")
    var layout: Dictionary = JSON.parse_string(FileAccess.get_file_as_string(MAP_PATH))
    _make_tileset()
    _make_spriteframes("hero", 48, 4)
    _make_spriteframes("hero-3d-atlas", 128, 4)
    for name in ["elder", "smith", "merchant", "villager", "goblin"]:
        _make_spriteframes(name, 48, 4)
    _make_spriteframes("mossling", 48, 1)
    _make_spriteframes("guardian", 64, 1)
    _create_player()
    _create_npc_templates(layout)
    _create_enemy_templates()
    _create_herb_template()
    _create_world(layout)
    _create_hud()
    _create_main()
    print("[BUILDER] OK: saved genuine TileMapLayers, 8 SpriteFrames atlases, props, NPCs, enemies, HUD and main scene.")
    quit(0)

func _attach(parent: Node, child: Node, root: Node) -> void:
    parent.add_child(child)
    child.owner = root

func _save(root: Node, destination: String) -> void:
    var packed := PackedScene.new()
    var error := packed.pack(root)
    if error != OK:
        push_error("Cannot pack %s : %s" % [destination, error_string(error)])
        quit(1)
        return
    error = ResourceSaver.save(packed, destination)
    if error != OK:
        push_error("Cannot save %s : %s" % [destination, error_string(error)])
        quit(1)
    root.free()

func _make_tileset() -> void:
    var tile_set := TileSet.new()
    tile_set.tile_size = Vector2i(T, T)
    tile_set.add_physics_layer()
    tile_set.set_physics_layer_collision_layer(0, 1)
    tile_set.set_physics_layer_collision_mask(0, 1)
    var source := TileSetAtlasSource.new()
    source.texture = load("res://art/terrain/tileset.png")
    source.texture_region_size = Vector2i(T, T)
    for row in range(4):
        for col in range(16):
            var tile := Vector2i(col, row)
            source.create_tile(tile)
            if row == 2:
                # Only water gets a native TileSet collision polygon.
                var data := source.get_tile_data(tile, 0)
                data.set_collision_polygons_count(0, 1)
                data.set_collision_polygon_points(0, 0, PackedVector2Array([
                    Vector2(-16,-16), Vector2(16,-16), Vector2(16,16), Vector2(-16,16)
                ]))
    tile_set.add_source(source, 0)
    var err := ResourceSaver.save(tile_set, TILESET_PATH)
    if err != OK:
        push_error("TileSet save failed: " + error_string(err))
        quit(1)
    print("[BUILDER] TileSet saved with selectable grass/path/water/bridge atlas cells.")

func _make_spriteframes(name: String, cell: int, four_dirs: int) -> void:
    var texture: Texture2D = load("res://art/characters/%s.png" % name)
    if texture == null:
        push_error("Missing sprite: " + name)
        quit(1)
        return
    var columns := texture.get_width() / cell
    var rows := texture.get_height() / cell
    var frames := SpriteFrames.new()
    if frames.has_animation("default"):
        frames.remove_animation("default")
    for direction in range(4):
        var row: int = mini(direction, rows - 1) if four_dirs == 4 else 0
        var suffix: String = ANIMATION_DIRECTIONS[direction]
        for kind in ["idle", "walk", "attack", "hit", "death"]:
            var animation := "%s_%s" % [kind, suffix]
            frames.add_animation(animation)
            var ids: Array[int] = [0, 1]
            match kind:
                "walk": ids = [2,3,4,5]
                "attack": ids = [6,7,8,9]
                "hit": ids = [1]
                "death": ids = [0]
            frames.set_animation_speed(animation, 6.0 if kind == "walk" else 5.0)
            frames.set_animation_loop(animation, kind in ["idle","walk"])
            for idx in ids:
                if idx >= columns:
                    continue
                var atlas := AtlasTexture.new()
                atlas.atlas = texture
                atlas.region = Rect2(idx * cell, row * cell, cell, cell)
                frames.add_frame(animation, atlas)
    var dest := "res://resources/animations/%s.tres" % name
    var err := ResourceSaver.save(frames, dest)
    if err != OK:
        push_error("SpriteFrames save failed: " + dest + " : " + error_string(err))
        quit(1)

func _new_animated(parent: Node, root: Node, art_name: String, size: int, foot_y: float) -> AnimatedSprite2D:
    var art := AnimatedSprite2D.new()
    art.name = "AnimatedSprite2D"
    art.sprite_frames = load("res://resources/animations/%s.tres" % art_name)
    art.position = Vector2(0, foot_y)
    _attach(parent, art, root)
    art.animation = "idle_down"
    return art

func _collider(parent: Node, root: Node, radius: float, shift_y: float) -> void:
    var node := CollisionShape2D.new()
    node.name = "CollisionShape2D"
    var shape := CircleShape2D.new()
    shape.radius = radius
    node.shape = shape
    node.position = Vector2(0, shift_y)
    _attach(parent, node, root)

func _create_player() -> void:
    var player := CharacterBody2D.new()
    player.name = "Player"
    player.collision_layer = 2
    player.collision_mask = 1
    player.set_script(load("res://scripts/player.gd"))
    _new_animated(player, player, "hero", 48, -19)
    _collider(player, player, 10.0, -8)
    var camera := Camera2D.new()
    camera.name = "Camera2D"
    camera.enabled = true
    camera.zoom = Vector2(2, 2)
    camera.limit_left = 0
    camera.limit_top = 0
    camera.limit_right = T * 40
    camera.limit_bottom = T * 30
    camera.position_smoothing_enabled = true
    camera.position_smoothing_speed = 7.0
    _attach(player, camera, player)
    _save(player, "res://scenes/base/player.tscn")

func _create_npc_templates(layout: Dictionary) -> void:
    var seen: Dictionary = {}
    for data in layout["npcs"]:
        var sprite_name: String = data["sprite"]
        var id_name: String = data["id"]
        if seen.has(id_name):
            continue
        seen[id_name] = true
        var npc := Node2D.new()
        npc.name = id_name.capitalize()
        npc.set_script(load("res://scripts/npc.gd"))
        npc.set("character_name", data["name"])
        npc.set("role", data["role"])
        _new_animated(npc, npc, sprite_name, 48, -17)
        var body := StaticBody2D.new()
        body.name = "StaticBody2D"
        body.collision_layer = 1
        _attach(npc, body, npc)
        _collider(body, npc, 10.0, -7)
        var label := Label.new()
        label.name = "NameLabel"
        label.text = data["name"]
        label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
        label.position = Vector2(-72, -64)
        label.size = Vector2(144, 22)
        label.add_theme_font_size_override("font_size", 11)
        label.add_theme_color_override("font_color", Color("#f2e0ac"))
        _attach(npc, label, npc)
        _save(npc, "res://scenes/base/npc_%s.tscn" % id_name)

func _create_enemy_templates() -> void:
    for sprite_name in ["mossling","goblin","guardian"]:
        var enemy := CharacterBody2D.new()
        enemy.name = sprite_name.capitalize()
        enemy.collision_layer = 2
        enemy.collision_mask = 1
        enemy.set_script(load("res://scripts/enemy.gd"))
        _new_animated(enemy, enemy, sprite_name, 64 if sprite_name=="guardian" else 48, -24)
        _collider(enemy, enemy, 11.0 if sprite_name!="guardian" else 18.0, -9)
        var timer := Timer.new()
        timer.name = "RespawnTimer"
        timer.wait_time = 20.0
        timer.one_shot = true
        _attach(enemy, timer, enemy)
        var health := ProgressBar.new()
        health.name = "HealthBar"
        health.show_percentage = false
        health.position = Vector2(-23, -52 if sprite_name!="guardian" else -70)
        health.size = Vector2(46, 6)
        health.value = 100
        health.mouse_filter = Control.MOUSE_FILTER_IGNORE
        _attach(enemy, health, enemy)
        _save(enemy, "res://scenes/base/enemy_%s.tscn" % sprite_name)

func _create_herb_template() -> void:
    var herb := Area2D.new()
    herb.name = "Herb"
    herb.collision_layer = 0
    herb.collision_mask = 0
    herb.set_script(load("res://scripts/herb.gd"))
    var sprite := Sprite2D.new()
    sprite.name = "Sprite2D"
    var tex := AtlasTexture.new()
    tex.atlas = load("res://art/characters/icons.png")
    tex.region = Rect2(24, 0, 24, 24)
    sprite.texture = tex
    sprite.position = Vector2(0,-9)
    _attach(herb,sprite,herb)
    _collider(herb,herb,12.0,-10)
    _save(herb,"res://scenes/base/herb.tscn")

func _create_prop(group: Node2D, scene_root: Node2D, kind: String, pixel: Vector2,
                  extra_offset: int, collision_size: Vector2, is_building: bool=false) -> void:
    var texture: Texture2D = load("res://art/environment/%s.png" % kind)
    if texture == null:
        push_error("Missing art for prop: " + kind)
        return
    var container := Node2D.new()
    container.name = "%s_%d_%d" % [kind.capitalize(), roundi(pixel.x), roundi(pixel.y)]
    container.position = pixel
    _attach(group,container,scene_root)
    var image := Sprite2D.new()
    image.name = "Sprite2D"
    image.texture = texture
    image.offset = Vector2(0,-texture.get_height()/2.0 + extra_offset)
    _attach(container,image,scene_root)
    if collision_size != Vector2.ZERO:
        var body := StaticBody2D.new()
        body.name = "StaticBody2D"
        body.collision_layer = 1
        body.collision_mask = 2
        body.add_to_group("world_obstacle",true)
        _attach(container,body,scene_root)
        var box := CollisionShape2D.new()
        box.name = "CollisionShape2D"
        var shape := RectangleShape2D.new()
        shape.size = collision_size
        box.shape = shape
        box.position = Vector2(0, -collision_size.y/2.0 if is_building else -7.0)
        _attach(body,box,scene_root)
    if is_building:
        container.set_meta("building_kind", kind)

func _create_world(layout: Dictionary) -> void:
    var scene := Node2D.new()
    scene.name = "Village"
    scene.set_script(load("res://scripts/world.gd"))
    var tileset: TileSet = load(TILESET_PATH)
    var layers: Dictionary = {}
    for name in ["Ground","Roads","Water","Bridge"]:
        var layer := TileMapLayer.new()
        layer.name = name
        layer.tile_set = tileset
        layer.z_index = 0
        _attach(scene,layer,scene)
        layers[name] = layer
    var terrain: Array = layout["terrain"]
    var cells: Dictionary = {"grass":0,"path":1,"water":2,"bridge":3}
    var dirt_total := 0
    for y in range(terrain.size()):
        var row: Array = terrain[y]
        for x in range(row.size()):
            var cell := Vector2i(x,y)
            layers["Ground"].set_cell(cell,0,Vector2i((x * 7 + y * 11) % 16,0))
            var kind: String = row[x]
            if kind == "grass":
                continue
            if kind == "path":
                var mask := 0
                if y>0 and terrain[y-1][x] == "grass": mask |= 1
                if x<row.size()-1 and terrain[y][x+1] == "grass": mask |= 2
                if y<terrain.size()-1 and terrain[y+1][x] == "grass": mask |= 4
                if x>0 and terrain[y][x-1] == "grass": mask |= 8
                layers["Roads"].set_cell(cell,0,Vector2i(mask,1))
                dirt_total+=1
            elif kind == "water":
                layers["Water"].set_cell(cell,0,Vector2i((x * 3 + y * 5)%16,2))
            elif kind == "bridge":
                layers["Bridge"].set_cell(cell,0,Vector2i((x+y)%16,3))
    var actors := Node2D.new()
    actors.name = "Actors"
    actors.y_sort_enabled = true
    _attach(scene,actors,scene)
    var buildings := Node2D.new()
    buildings.name = "Buildings"
    buildings.y_sort_enabled = true
    _attach(actors,buildings,scene)
    var trees := Node2D.new()
    trees.name = "Trees"
    trees.y_sort_enabled = true
    _attach(actors,trees,scene)
    var decorations := Node2D.new()
    decorations.name = "Decorations"
    decorations.y_sort_enabled = true
    _attach(actors,decorations,scene)
    var npcs := Node2D.new()
    npcs.name = "NPCs"
    npcs.y_sort_enabled = true
    _attach(actors,npcs,scene)
    var enemies := Node2D.new()
    enemies.name = "Enemies"
    enemies.y_sort_enabled = true
    _attach(actors,enemies,scene)
    var herbs := Node2D.new()
    herbs.name = "Herbs"
    herbs.y_sort_enabled = true
    _attach(actors,herbs,scene)
    for data in layout["buildings"]:
        var building_kind: String = data["sprite"]
        var px := (float(data["x"]) + float(data["w"])/2.0)*T
        var py := (float(data["y"]) + float(data["h"]))*T
        _create_prop(buildings,scene,building_kind,Vector2(px,py),0,
            Vector2(float(data["w"])*T,float(data["h"])*T),true)
    var taken: Dictionary = {}
    for item in layout["npcs"]:
        taken["%d_%d" % [int(item["x"]),int(item["y"])]] = true
    for item in layout["enemies"]:
        taken["%d_%d" % [int(item["x"]),int(item["y"])]] = true
    for data in layout["objects"]:
        var x := int(data["x"])
        var y := int(data["y"])
        if taken.has("%d_%d" % [x,y]):
            continue
        var kind: String = data["sprite"]
        var target: Node2D = trees if kind in ["pine","oak","birch"] else decorations
        var px := (x+0.5)*T
        var py := (y+1.0)*T
        var offset := int(data.get("offset",0))
        var collision := Vector2.ZERO
        if bool(data.get("block",false)):
            collision = Vector2(20,15) if kind in ["pine","oak","birch"] else Vector2(21,16)
        _create_prop(target,scene,kind,Vector2(px,py),offset,collision)
    for data in layout["npcs"]:
        var file: String = "res://scenes/base/npc_%s.tscn" % data["id"]
        var npc: Node2D = load(file).instantiate()
        npc.position = Vector2((float(data["x"])+0.5)*T,(float(data["y"])+0.8)*T)
        _attach(npcs,npc,scene)
    for data in layout["enemies"]:
        var file: String = "res://scenes/base/enemy_%s.tscn" % data["sprite"]
        var enemy: CharacterBody2D = load(file).instantiate()
        enemy.name = "%s_%d_%d" % [str(data["sprite"]).capitalize(),int(data["x"]),int(data["y"])]
        enemy.position = Vector2((float(data["x"])+0.5)*T,(float(data["y"])+0.8)*T)
        enemy.display_name = data["name"]
        enemy.max_health = int(data["hp"])
        enemy.attack_damage = int(data["damage"])
        enemy.experience_reward = int(data["xp"])
        enemy.is_boss = bool(data.get("boss",false))
        _attach(enemies,enemy,scene)
    for pos in layout["herbs"]:
        var herb: Area2D = load("res://scenes/base/herb.tscn").instantiate()
        herb.name = "Herb_%d_%d" % [int(pos[0]),int(pos[1])]
        herb.position = Vector2((float(pos[0])+0.5)*T,(float(pos[1])+0.8)*T)
        _attach(herbs,herb,scene)
    var player: CharacterBody2D = load("res://scenes/base/player.tscn").instantiate()
    player.name = "Player"
    player.position = Vector2(560,506)
    _attach(actors,player,scene)
    _save(scene,"res://scenes/world/village.tscn")
    print("[BUILDER] Village: %d ground tiles, %d dirt tiles, original buildings, trees, NPCs and enemies saved." % [terrain.size()*terrain[0].size(),dirt_total])

func _styled_panel(title: String) -> PanelContainer:
    var panel := PanelContainer.new()
    panel.name = title
    var box := StyleBoxFlat.new()
    box.bg_color = Color("#221e19ee")
    box.border_color = Color("#9a784d")
    box.set_border_width_all(2)
    box.set_corner_radius_all(9)
    box.set_content_margin_all(10)
    panel.add_theme_stylebox_override("panel",box)
    return panel

func _label(parent: Node, root: Node, name: String, content: String,
            size: int=15) -> Label:
    var label := Label.new()
    label.name = name
    label.text = content
    label.add_theme_font_size_override("font_size",size)
    label.add_theme_color_override("font_color",Color("#f4e5ba"))
    _attach(parent,label,root)
    return label

func _button(parent: Node, root: Node, name: String, caption: String) -> Button:
    var button := Button.new()
    button.name = name
    button.text = caption
    button.custom_minimum_size = Vector2(120,36)
    _attach(parent,button,root)
    return button

func _create_hud() -> void:
    var hud := CanvasLayer.new()
    hud.name = "HUD"
    hud.set_script(load("res://scripts/hud.gd"))
    var screen := Control.new()
    screen.name = "Screen"
    screen.anchor_right = 1
    screen.anchor_bottom = 1
    screen.mouse_filter = Control.MOUSE_FILTER_IGNORE
    _attach(hud,screen,hud)

    var status_panel := _styled_panel("StatusPanel")
    status_panel.position = Vector2(15,15)
    status_panel.custom_minimum_size = Vector2(390,138)
    _attach(screen,status_panel,hud)
    var stats := VBoxContainer.new()
    stats.name = "Stats"
    _attach(status_panel,stats,hud)
    _label(stats,hud,"Title","ТИХОЛЕСЬЕ · ЛЕСНАЯ ДЕРЕВНЯ",18)
    _label(stats,hud,"StatsText","Ур. 1   Монеты: 0")
    var hp := ProgressBar.new()
    hp.name = "HealthBar"
    hp.custom_minimum_size = Vector2(340,17)
    hp.show_percentage = false
    _attach(stats,hp,hud)
    var xp := ProgressBar.new()
    xp.name = "ExperienceBar"
    xp.custom_minimum_size = Vector2(340,9)
    xp.show_percentage = false
    _attach(stats,xp,hud)
    var quest := _label(stats,hud,"QuestText","Поговори со старостой",13)
    quest.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART

    var action_box := VBoxContainer.new()
    action_box.name = "Actions"
    action_box.anchor_left = 1
    action_box.anchor_right = 1
    action_box.offset_left = -175
    action_box.offset_right = -14
    action_box.offset_top = 18
    _attach(screen,action_box,hud)
    _button(action_box,hud,"InventoryButton","🎒 Рюкзак (B)")
    _button(action_box,hud,"QuestButton","📜 Задания (J)")
    _button(action_box,hud,"PotionButton","🧪 Зелье (2)")
    _button(action_box,hud,"AttackButton","⚔ Атака")
    _button(action_box,hud,"SaveButton","💾 Сохранить")
    var minimap := TextureRect.new()
    minimap.name = "Minimap"
    minimap.texture = load("res://art/terrain/minimap.png")
    minimap.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
    minimap.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
    minimap.custom_minimum_size = Vector2(160,128)
    _attach(action_box,minimap,hud)

    var inv := _styled_panel("InventoryPanel")
    inv.anchor_left=1
    inv.anchor_right=1
    inv.offset_left=-367
    inv.offset_right=-14
    inv.offset_top=315
    inv.offset_bottom=690
    _attach(screen,inv,hud)
    var ivbox := VBoxContainer.new()
    ivbox.name="InventoryBox"
    _attach(inv,ivbox,hud)
    _label(ivbox,hud,"InventoryTitle","РЮКЗАК · ПЕРСОНАЖ",19)
    var items := RichTextLabel.new()
    items.name = "InventoryText"
    items.bbcode_enabled = true
    items.custom_minimum_size = Vector2(320,295)
    items.scroll_active = false
    _attach(ivbox,items,hud)
    _button(ivbox,hud,"CloseInventory","Закрыть")

    var dialogue := _styled_panel("DialoguePanel")
    dialogue.anchor_left = 0.22
    dialogue.anchor_right = 0.78
    dialogue.anchor_top = 1
    dialogue.anchor_bottom = 1
    dialogue.offset_top = -215
    dialogue.offset_bottom = -16
    _attach(screen,dialogue,hud)
    var dbox := VBoxContainer.new()
    dbox.name = "DialogueBox"
    _attach(dialogue,dbox,hud)
    _label(dbox,hud,"DialogueTitle","Разговор",19)
    var message := _label(dbox,hud,"DialogueText","",14)
    message.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
    message.custom_minimum_size = Vector2(450,68)
    var actions := HBoxContainer.new()
    actions.name = "DialogueActions"
    _attach(dbox,actions,hud)
    _button(actions,hud,"BuyPotion","Зелье: 10 монет")
    _button(actions,hud,"SellWood","Продать древесину")
    _button(actions,hud,"RestButton","Отдохнуть")
    _button(dbox,hud,"CloseDialogue","Закрыть диалог")

    var toast := _label(screen,hud,"ToastText","",17)
    toast.anchor_left=0.25
    toast.anchor_right=0.75
    toast.position=Vector2(0,173)
    toast.horizontal_alignment=HORIZONTAL_ALIGNMENT_CENTER
    var timer := Timer.new()
    timer.name = "ToastTimer"
    timer.wait_time = 2.6
    timer.one_shot = true
    _attach(hud,timer,hud)
    _save(hud,"res://scenes/base/hud.tscn")

func _create_main() -> void:
    var main := Node2D.new()
    main.name = "Main"
    main.set_script(load("res://scripts/main.gd"))
    var world: Node2D = load("res://scenes/world/village.tscn").instantiate()
    world.name = "Village"
    _attach(main,world,main)
    var hud: CanvasLayer = load("res://scenes/base/hud.tscn").instantiate()
    hud.name = "HUD"
    _attach(main,hud,main)
    _save(main,ROOT_SCENE)
